# Database connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/recarbo_db?schema=public"

# Server configuration
PORT=5000
NODE_ENV=development

# Frontend URL for CORS and Socket.io
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secret
JWT_SECRET="recarbo_ultra_secure_jwt_secret_key_2025"
JWT_EXPIRES_IN="7d"

# Platform Config Defaults (Read dynamically from DB / Admin Settings)
PLATFORM_FEE_PERCENTAGE=2.5
TRANSPORT_RATE=12.5

# External API Keys (Local / Mock fallbacks enabled if absent)
AI_API_KEY="demo_ai_key"
MAP_API_KEY="demo_map_key"
